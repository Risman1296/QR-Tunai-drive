{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": [
				"$eslint - stylish"
			],
			"group": "build"
		},
		{
			"label": "Start dev server on 5000",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev:5000"
			],
			"isBackground": true,
			"problemMatcher": [
				"$eslint - stylish"
			],
			"group": "build"
		}
	]
}