{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "dev:5000": "next dev --turbopack -p 5000",
    "dev:prod": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "start:prod": "cross-env NODE_ENV=production next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "build:cf": "cross-env ENABLE_WIFI_AUTOMATION=false START_WIFI_AUTOMATION=false npx @cloudflare/next-on-pages@latest",
    "dev:cf": "cross-env ENABLE_WIFI_AUTOMATION=false START_WIFI_AUTOMATION=false npx @cloudflare/next-on-pages@latest && npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "deploy:cf": "cross-env ENABLE_WIFI_AUTOMATION=false START_WIFI_AUTOMATION=false npx @cloudflare/next-on-pages@latest && npx wrangler pages deploy .vercel/output/static"
  },
